# Copy to .env (never commit .env — it is git-ignored) and fill in real values.
# This file lists variable NAMES with harmless placeholders only.

# --- Database -----------------------------------------------------------------
# Postgres connection string used by the app and `prisma migrate deploy`.
# On Render, use the Internal connection string; on Supabase use the Session
# pooler URL (hard cap: 15 concurrent connections — see DB_POOL_MAX).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# OPTIONAL. Connection used ONLY by the Prisma CLI (`prisma migrate deploy`, the
# Render pre-deploy command) when the schema owner differs from the app's role.
# Lets DATABASE_URL be a least-privilege role (SELECT/INSERT/UPDATE/DELETE, no DDL,
# not the table owner) — see docs/security.md "Database roles". Unset = the CLI
# uses DATABASE_URL.
# MIGRATE_DATABASE_URL="postgresql://OWNER:PASSWORD@HOST:5432/DBNAME"
# Scratch database, only needed for `prisma migrate dev` and the CI drift check.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_shadow"
# Maximum pooled connections (default 10, clamped to 12). Keep below the
# database's own limit minus headroom for migrations/second instance.
# DB_POOL_MAX=10

# --- Auth ---------------------------------------------------------------------
# Signs/encrypts session JWTs. Generate a new one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"
# Key for operator join-request verification codes (HMAC). Use a DIFFERENT random
# value from AUTH_SECRET so leaking/rotating one does not touch the other. Unset =
# falls back to AUTH_SECRET (the startup log warns in production).
# JOIN_CODE_SECRET="generate-another-32-random-bytes"
# OPTIONAL, TEMPORARY. Roll AUTH_SECRET without signing everyone out: set this to the OLD AUTH_SECRET,
# put the NEW value in AUTH_SECRET, deploy, and remove this after 30 days. See docs/configuration.md section 8.
# AUTH_SECRET_PREVIOUS=""
# Password for the hidden /support console. Leave unset to DISABLE the console
# (its login endpoint then answers 404).
# SUPPORT_ACCESS_PASSWORD=""

# --- Public URL / CSRF / proxies ------------------------------------------------
# Public base URL of THIS deployment. REQUIRED in production: password-reset
# links are built from it (never from request headers) and it is a trusted
# origin for the CSRF check.
APP_URL="https://your-domain.example"
# Extra origins allowed to make state-changing requests (comma separated), e.g.
# the onrender.com URL while you also use a custom domain.
# ALLOWED_ORIGINS="https://your-service.onrender.com"
# Number of reverse proxies in front of the app that append to
# X-Forwarded-For (used for rate-limit client IPs). Render's proxy layer = 1.
# TRUSTED_PROXY_HOPS=1

# --- Email (forgot-password) ----------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Excavator Manager <no-reply@your-domain.example>"

# --- Android in-app updates -----------------------------------------------------
# "owner/repo" whose latest GitHub Release carries version.json (see README).
GITHUB_RELEASE_REPO="owner/repo"
# Optional token to raise GitHub's unauthenticated rate limit.
# GITHUB_API_TOKEN=""

# --- Observability --------------------------------------------------------------
# debug | info | warn | error (default info). Logs are one JSON object per line.
# LOG_LEVEL=info

# --- Tests ----------------------------------------------------------------------
# DB-backed tests create/delete throwaway businesses. Point this at a NON-production
# database (falls back to DATABASE_URL when unset).
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_test"

# --- Tooling only (never needed by the running app) -------------------------------
# Database the restore drill (scripts/restore-drill.mjs) reads from; use a NON-production one.
# DRILL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Override the migrations directory (used by scripts/test-migrations.mjs); leave unset normally.
# PRISMA_MIGRATIONS_PATH="prisma/migrations"
