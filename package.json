{
  "name": "excavator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:android": "node scripts/build-android.mjs",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:migrations": "node scripts/test-migrations.mjs",
    "prisma:validate": "prisma validate",
    "check": "npm run lint && npm run typecheck && npm run prisma:validate && npm test",
    "authz:matrix": "node scripts/route-inventory.mjs",
    "authz:check": "node scripts/route-inventory.mjs --check",
    "audit:integrity": "node scripts/audit-integrity.mjs",
    "check:config": "node --experimental-strip-types scripts/check-config.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:db-role": "node scripts/check-db-role.mjs",
    "scoreboard": "node scripts/scoreboard.mjs",
    "shutdown:drill": "node scripts/shutdown-drill.mjs",
    "licenses": "node scripts/license-report.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-check": "^3.23.2",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^3.2.7"
  }
}
