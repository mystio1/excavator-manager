<?xml version="1.0" encoding="utf-8"?>
<!-- All traffic must be HTTPS: the app talks only to the deployed API and
     GitHub release downloads. No cleartext, and only system CAs are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
