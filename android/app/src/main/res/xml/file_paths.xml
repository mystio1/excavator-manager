<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only the two app-private directories the plugins write to are shareable
         through the FileProvider (the Capacitor template's blanket
         external-path/cache-path "." entries were removed). -->
    <!-- Where UpdateInstallerPlugin downloads release APKs -->
    <external-files-path name="updates" path="updates/" />
    <!-- Where FileSaverPlugin saves files (e.g. bill Excel exports) for viewing/sharing -->
    <external-files-path name="downloads" path="downloads/" />
</paths>